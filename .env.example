# 复制为 .env 并按需填写（.env 已在 .gitignore 中，请勿提交真实密钥）

# PostgreSQL 数据库连接串（Supabase / Neon 等）
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.xxxx.supabase.co:5432/postgres"

# 站点公开 URL（用于 OG / canonical）
NEXT_PUBLIC_SITE_URL="https://plan.surveykit.cc"

# 后台管理口令（生产环境务必改为强口令，勿用 demo1234）
ADMIN_PASSWORD="change-me"

# LLM 抽取网关（可选；未配置时回退到规则解析器 extractDraft）
LLM_BASE_URL=""
LLM_API_KEY=""
LLM_MODELS="deepseek-v4-flash,glm-4.7-flash"
