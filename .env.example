# 复制为 .env 并按需填写（.env 已在 .gitignore 中，请勿提交真实密钥）

# Serverless 运行时使用 Supabase Transaction Pool（6543）
DATABASE_URL="postgresql://postgres.PROJECT_REF:[YOUR-PASSWORD]@aws-0-REGION.pooler.supabase.com:6543/postgres"

# Prisma Migrate 使用直连地址（不要用于 Cloudflare Worker 运行时）
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.PROJECT_REF.supabase.co:5432/postgres"

# 后台管理口令（生产环境务必改为强口令，勿用 demo1234）
ADMIN_PASSWORD="change-me"

# LLM 抽取网关（可选；未配置时回退到规则解析器 extractDraft）
LLM_BASE_URL=""
LLM_API_KEY=""
LLM_MODELS="deepseek-v4-flash,glm-4.7-flash"
